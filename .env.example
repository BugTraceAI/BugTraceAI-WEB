# Standalone WEB configuration. Copy to .env.docker and set a unique password.
# The Launcher generates this configuration itself for connected profiles.
FRONTEND_PORT=6869
POSTGRES_PORT=5432
POSTGRES_USER=bugtraceai
POSTGRES_DB=bugtraceai_web
POSTGRES_PASSWORD=

# Optional scanning engines. WEB starts without them; scans require a backend.
CLI_API_PORT=8000
BTAI_API_PORT=8005
VITE_API_URL=/api
VITE_CLI_API_URL=/cli-api
VITE_BTAI_API_URL=/btai-api
BTAI_SHARED_NETWORK=bugtraceai-platform
